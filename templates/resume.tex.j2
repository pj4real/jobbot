<% endfor %>\end{itemize}
<% endfor %><% endif %>

%% ---------- projects ----------
<% if projects %>\section{Projects}
<% for p in projects %>\textbf{<<p.name>>}<% if p.stack %> {\small\textit{(<<p.stack>>)}}<% endif %><% if p.link %>\hfill\href{<<p.link>>}{\small link}<% endif %>
