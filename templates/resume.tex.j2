<% for b in p.bullets %>  \item <<b>>
<% endfor %>\end{itemize}
<% endfor %><% endif %>

%% ---------- skills ----------
<% if skills %>\section{Skills}
\begin{itemize}
<% for g in skills %>  \item \textbf{<<g.group>>:} <<g["items"]|join(', ')>>
<% endfor %>\end{itemize}
<% endif %>

%% ---------- achievements ----------
<% if achievements %>\section{Achievements}
\begin{itemize}
<% for a in achievements %>  \item <<a>>
<% endfor %>\end{itemize}
<% endif %>

