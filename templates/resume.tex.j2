\titleformat{\section}{\normalsize\bfseries\uppercase}{}{0em}{}[\vspace{0.15em}\color{rule}\hrule]
\titlespacing{\section}{0pt}{<<opts.section_before>>em}{0.35em}

\newcommand{\entry}[4]{%
  \textbf{#1}\hfill\textbf{#2}\\
  \textit{#3}\hfill\textit{#4}\vspace{0.15em}%
}
